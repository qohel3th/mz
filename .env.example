# Warrior Identity Academy — environment
# Copy to .env.local. All values are public (NEXT_PUBLIC_) — no secrets in this MVP.

# Storage driver: "local" (localStorage, default) | "supabase" (PostgREST via anon key, RLS off)
NEXT_PUBLIC_STORAGE_DRIVER=local

# Supabase project (Project Settings → API). Anon key only — never the DB password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider: "mock" (deterministic canned responses, default)
NEXT_PUBLIC_AI_PROVIDER=mock
